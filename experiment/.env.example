# Copy to .env; never put real secrets in this example or in Sites browser code.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# Speech API adapter: currently deprecated, scheduled shutdown 2027-01-06.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# Muse creates the live-action video. Also reads the key from muse/.env if present.
MUSE_API_KEY=
MUSE_API_BASE_URL=https://muse-api.butterflyro.space
MUSE_VIDEO_MODEL=muse-video
MUSE_TIMEOUT_SECONDS=300
MUSE_POLL_SECONDS=5

# Generate these with scripts/init_config.py. Do not use the OpenAI key here.
VIDEO_API_TOKEN=
PLAYBACK_SECRET=
# Full HTTPS Cloudflare URL, no trailing slash; can be changed without a code edit.
PUBLIC_BASE_URL=
# CORS allows all origins; keep the service token in the website backend proxy.

STORAGE_BACKEND=minio
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=marketing-videos
# Keep false if bucket already exists; true permits creating this single bucket.
MINIO_CREATE_BUCKET=false

DATA_DIR=./data
MAX_UPLOAD_MB=40
MAX_PENDING_JOBS=4
PLAYBACK_TTL_SECONDS=3600
FFMPEG_BINARY=
FONT_PATH=/System/Library/Fonts/Supplemental/Arial.ttf

# Optional real image-to-video inference: disabled until local model is prepared.
LOCAL_MOTION_ENABLED=false
LOCAL_MOTION_MODEL=./models/ltx-video
LOCAL_MOTION_DEVICE=mps
LOCAL_MOTION_TIMEOUT=1200
CORS_ORIGINS=*
